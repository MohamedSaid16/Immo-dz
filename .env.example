# Copy this file to `.env.local` and fill in your values.

# Supabase — Settings → API in your Supabase project.
# Powers auth, property data, and photo uploads (Supabase Storage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only trusted publishing client. Never use NEXT_PUBLIC_ here.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin used by metadata, canonical links, sitemap, robots,
# sharing and QR codes. Required for preview and production builds.
# Local development may use: http://localhost:3000
# Vercel Preview example: https://your-stable-preview-domain.vercel.app
NEXT_PUBLIC_SITE_URL=

# Internal AI Property Marketing Assistant (server-only, disabled by default).
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-5.4-mini-2026-03-17
AI_REQUEST_TIMEOUT_MS=15000
AI_DAILY_GENERATION_LIMIT=20

# P3 social publishing (server-only, disabled until a trusted n8n endpoint exists).
SOCIAL_PUBLISHING_ENABLED=false
N8N_PUBLISH_WEBHOOK_URL=
N8N_PUBLISH_WEBHOOK_SECRET=
SOCIAL_PUBLISHING_TIMEOUT_MS=5000

# Never expose Supabase secret/service-role keys through NEXT_PUBLIC_* variables.
# The current MVP uses only the authenticated user session plus RLS for writes.
